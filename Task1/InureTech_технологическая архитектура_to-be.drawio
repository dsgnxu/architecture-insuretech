          <mxGeometry height="36" width="280" x="562" y="684" as="geometry" />
        </mxCell>
        <mxCell id="pg2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF6B6B;strokeWidth=1.2;arcSize=8;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;fontFamily=Helvetica;" value="PostgreSQL (sync replica)&#xa;Patroni · promote&#xa;RPO ≈ 0" vertex="1">
          <mxGeometry height="62" width="186" x="528" y="770" as="geometry" />
        </mxCell>
        <mxCell id="read2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#E0A100;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;fontFamily=Helvetica;fontColor=#1A1A1A;" value="reads → replica&#xa;writes → primary (AZ1)" vertex="1">
          <mxGeometry height="52" width="180" x="736" y="780" as="geometry" />
        </mxCell>
        <mxCell id="cbox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#C5CDD8;strokeWidth=1.4;arcSize=8;" value="" vertex="1">
          <mxGeometry height="560" width="400" x="960" y="78" as="geometry" />
        </mxCell>
        <mxCell id="ct" parent="1" style="text;html=1;fontStyle=1;fontSize=13;fontColor=#1A1A1A;fontFamily=Helvetica;" value="Комментарии" vertex="1">
          <mxGeometry height="22" width="368" x="976" y="90" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DCE8;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontColor=#1A1A1A;" value="&lt;b&gt;1. Масштабирование&lt;/b&gt;&lt;br&gt;Выбрано &lt;b&gt;горизонтальное&lt;/b&gt; (HPA + Cluster Autoscaler). Вертикальное — запас нод/БД. Доп. AZ: да (2 зоны) → доступность &lt;b&gt;99,9%&lt;/b&gt;." vertex="1">
          <mxGeometry height="52" width="368" x="976" y="118" as="geometry" />
        </mxCell>
        <mxCell id="c3a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DCE8;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontColor=#1A1A1A;" value="&lt;b&gt;2. Kubernetes: независимые кластеры&lt;/b&gt;&lt;br&gt;Два отдельных Managed Kubernetes (cluster 1 в AZ1, cluster 2 в AZ2), &lt;b&gt;не один растянутый&lt;/b&gt;.&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="62" width="368" x="976" y="178" as="geometry" />
        </mxCell>
        <mxCell id="c3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DCE8;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontColor=#1A1A1A;" value="&lt;b&gt;3. Балансировка + Health checks&lt;/b&gt;&lt;br&gt;Клиент → Cloud DNS → Cloud CDN (статика React из Object Storage) и ALB (динамика B2C/B2B) → Ingress кластера → Service → Pod." vertex="1">
          <mxGeometry height="62" width="368" x="976" y="248" as="geometry" />
        </mxCell>
        <mxCell id="c3c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DCE8;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontColor=#1A1A1A;" value="&lt;b&gt;4. Failover&lt;/b&gt;&lt;br&gt;Active-Active на уровне приложений: оба AZ в пуле ALB. Баннер над зонами. DNS failover (TTL ≤ 60 с) — запасной контур." vertex="1">
          <mxGeometry height="62" width="368" x="976" y="322" as="geometry" />
        </mxCell>
        <mxCell id="c3d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DCE8;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontColor=#1A1A1A;" value="&lt;b&gt;4. База данных&lt;/b&gt;&lt;br&gt;Managed PostgreSQL HA, фреймворк кластера — &lt;b&gt;Patroni&lt;/b&gt;. Primary (AZ1) + synchronous replica (AZ2): RPO ≈ 0. Continuous WAL и snapshot ≤ 15 мин → Object Storage, PITR ≥ 7 дней. Auto-promote replica; restore 50 GB укладывается в RTO 45 мин." vertex="1">
          <mxGeometry height="96" width="368" x="976" y="396" as="geometry" />
        </mxCell>
