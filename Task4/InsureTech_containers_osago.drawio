        <mxCell id="aggdb" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#2E6DA4;align=center;fontSize=11;" value="&lt;b&gt;aggregator store&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;снимок каталога&lt;br&gt;+ &lt;b&gt;outbox&lt;/b&gt;" vertex="1">
